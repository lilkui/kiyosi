{
    "version": 6,
    "configurePresets": [
        {
            "name": "windows-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows x64 Debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows x64 Release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-sanitizers",
            "displayName": "Linux ASan + UBSan",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "KIYOSI_ENABLE_SANITIZERS": true
            }
        },
        {
            "name": "linux-quality",
            "displayName": "Linux quality checks",
            "inherits": "linux-debug",
            "cacheVariables": {
                "CMAKE_COMPILE_WARNING_AS_ERROR": true,
                "KIYOSI_ENABLE_CLANG_FORMAT": true,
                "KIYOSI_ENABLE_CLANG_TIDY": true
            }
        },
        {
            "name": "windows-ci",
            "displayName": "Windows x64 Release (warnings as errors)",
            "inherits": "windows-release",
            "cacheVariables": {
                "CMAKE_COMPILE_WARNING_AS_ERROR": true
            }
        },
        {
            "name": "linux-ci",
            "displayName": "Linux Release (warnings as errors)",
            "inherits": "linux-release",
            "cacheVariables": {
                "CMAKE_COMPILE_WARNING_AS_ERROR": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "windows-ci",
            "configurePreset": "windows-ci"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-ci",
            "configurePreset": "linux-ci"
        },
        {
            "name": "linux-sanitizers",
            "configurePreset": "linux-sanitizers"
        },
        {
            "name": "linux-quality",
            "configurePreset": "linux-quality",
            "targets": [
                "all",
                "kiyosi-format-check"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "execution": { "noTestsAction": "error" }
        },
        {
            "name": "windows-debug",
            "inherits": "test-base",
            "configurePreset": "windows-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-release",
            "inherits": "test-base",
            "configurePreset": "windows-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-debug",
            "inherits": "test-base",
            "configurePreset": "linux-debug",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-release",
            "inherits": "test-base",
            "configurePreset": "linux-release",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "windows-ci",
            "inherits": "test-base",
            "configurePreset": "windows-ci",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-ci",
            "inherits": "test-base",
            "configurePreset": "linux-ci",
            "output": {
                "outputOnFailure": true
            }
        },
        {
            "name": "linux-sanitizers",
            "inherits": "test-base",
            "configurePreset": "linux-sanitizers",
            "output": {
                "outputOnFailure": true
            },
            "environment": {
                "UBSAN_OPTIONS": "halt_on_error=1"
            }
        }
    ]
}
