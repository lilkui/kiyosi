{
    "version": 6,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": true
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "windows-debug",
            "displayName": "Windows x64 Debug",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "windows-release",
            "displayName": "Windows x64 Release",
            "inherits": "windows-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "linux-debug",
            "displayName": "Linux Debug",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "linux-release",
            "displayName": "Linux Release",
            "inherits": "linux-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "linux-sanitizers",
            "displayName": "Linux ASan + UBSan",
            "inherits": "linux-debug",
            "cacheVariables": {
                "KIYOSI_ENABLE_SANITIZERS": true
            }
        },
        {
            "name": "quality",
            "displayName": "Quality checks",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_COMPILE_WARNING_AS_ERROR": true,
                "KIYOSI_ENABLE_CLANG_FORMAT": true,
                "KIYOSI_ENABLE_CLANG_TIDY": true,
                "KIYOSI_BUILD_PYTHON": true
            }
        }
    ],
    "buildPresets": [
        {
            "name": "windows-debug",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "configurePreset": "windows-release"
        },
        {
            "name": "linux-debug",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-sanitizers",
            "configurePreset": "linux-sanitizers"
        },
        {
            "name": "quality",
            "configurePreset": "quality",
            "targets": [
                "all",
                "kiyosi-format-check"
            ]
        }
    ],
    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "execution": { "noTestsAction": "error" },
            "output": { "outputOnFailure": true }
        },
        {
            "name": "windows-debug",
            "inherits": "test-base",
            "configurePreset": "windows-debug"
        },
        {
            "name": "windows-release",
            "inherits": "test-base",
            "configurePreset": "windows-release"
        },
        {
            "name": "linux-debug",
            "inherits": "test-base",
            "configurePreset": "linux-debug"
        },
        {
            "name": "linux-release",
            "inherits": "test-base",
            "configurePreset": "linux-release"
        },
        {
            "name": "linux-sanitizers",
            "inherits": "test-base",
            "configurePreset": "linux-sanitizers",
            "environment": {
                "UBSAN_OPTIONS": "halt_on_error=1"
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "windows-release",
            "steps": [
                { "type": "configure", "name": "windows-release" },
                { "type": "build", "name": "windows-release" },
                { "type": "test", "name": "windows-release" }
            ]
        },
        {
            "name": "linux-release",
            "steps": [
                { "type": "configure", "name": "linux-release" },
                { "type": "build", "name": "linux-release" },
                { "type": "test", "name": "linux-release" }
            ]
        },
        {
            "name": "linux-sanitizers",
            "steps": [
                { "type": "configure", "name": "linux-sanitizers" },
                { "type": "build", "name": "linux-sanitizers" },
                { "type": "test", "name": "linux-sanitizers" }
            ]
        }
    ]
}
