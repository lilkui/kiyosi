@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT "@BUILD_SHARED_LIBS@")
    find_dependency(TBB 2023.1 CONFIG COMPONENTS tbb)
endif()

if(@KIYOSI_ENABLE_CUDA@ AND NOT "@BUILD_SHARED_LIBS@")
    find_dependency(CUDAToolkit)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/kiyosiTargets.cmake")

check_required_components(kiyosi)
